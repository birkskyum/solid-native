{
  "name": "solid-native-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "A Solid-owned native application platform, initially backed by React Native's lower-level runtime.",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": "^22.13.0 || ^24.3.0 || >=26.0.0"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "check": "pnpm -r --if-present check",
    "ci:verify": "pnpm format:check && pnpm licenses:verify && pnpm boundaries:verify && pnpm build && pnpm packages:verify && pnpm check && pnpm test",
    "test": "node --test scripts/*.test.mjs && pnpm -r --if-present test",
    "benchmark": "pnpm --filter @solid-native/testing benchmark",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "licenses:inventory": "node scripts/verify-dependency-licenses.mjs --json",
    "licenses:verify": "node scripts/verify-dependency-licenses.mjs",
    "boundaries:verify": "node scripts/verify-architecture-boundaries.mjs && pnpm --filter @solid-native/fabric-host boundary:verify",
    "packages:verify": "node scripts/verify-package-artifacts.mjs",
    "packages:release-plan": "node scripts/package-release-plan.mjs",
    "starter:verify": "node scripts/verify-external-starter.mjs"
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "typescript": "^5.9.2"
  },
  "pnpm": {
    "patchedDependencies": {
      "react-native-screens@4.27.0": "packages/navigation/patches/react-native-screens@4.27.0.patch"
    }
  }
}
