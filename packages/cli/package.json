{
  "name": "@solid-native/cli",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Local project, build, diagnostics, and upgrade tooling for Solid Native.",
  "engines": {
    "node": "^22.13.0 || ^24.3.0 || >=26.0.0"
  },
  "bin": {
    "solid-native": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "templates"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.type-tests.json",
    "test": "pnpm build && node --test test/*.test.mjs"
  },
  "dependencies": {
    "@jridgewell/trace-mapping": "0.3.31",
    "@react-native-community/cli": "20.2.0",
    "@solid-native/codegen": "workspace:*",
    "@solid-native/observability": "workspace:*",
    "@solid-native/react-native-compat": "workspace:*",
    "stacktrace-parser": "0.1.11"
  },
  "devDependencies": {
    "@types/node": "^26.2.0"
  }
}
