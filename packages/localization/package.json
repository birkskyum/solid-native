{
  "name": "@solid-native/localization",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Validated startup locale and native layout-direction state.",
  "engines": {
    "node": "^22.13.0 || ^24.3.0 || >=26.0.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./react-native": {
      "types": "./dist/react-native.d.ts",
      "default": "./dist/react-native.js"
    }
  },
  "files": [
    "dist/index.d.ts",
    "dist/index.d.ts.map",
    "dist/index.js",
    "dist/index.js.map",
    "dist/react-native.d.ts",
    "dist/react-native.d.ts.map",
    "dist/react-native.js",
    "dist/react-native.js.map",
    "dist/react-native-adapter.d.ts",
    "dist/react-native-adapter.d.ts.map",
    "dist/react-native-adapter.js",
    "dist/react-native-adapter.js.map"
  ],
  "dependencies": {
    "@solid-native/react-native-compat": "workspace:*"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm build && node --test test/*.test.mjs"
  }
}
